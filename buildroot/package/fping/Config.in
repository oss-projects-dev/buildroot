if BR2_BUILD_USE_CUSTOM_SCRIPTS
if BR2_BUILD_USE_ASTLINUX_SCRIPTS
source package/fping/astlinux/Config.in
endif

endif #BR2_BUILD_USE_CUSTOM_SCRIPTS

if !BR2_BUILD_USE_CUSTOM_SCRIPTS

config BR2_PACKAGE_FPING
	bool "fping"
	help
	  fping is a program to send ICMP echo probes to network hosts,
	  similar to ping, but much better performing when pinging
	  multiple hosts.

	  http://fping.org/

endif #!BR2_BUILD_USE_CUSTOM_SCRIPTS
