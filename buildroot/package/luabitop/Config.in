if BR2_BUILD_USE_CUSTOM_SCRIPTS
if BR2_BUILD_USE_ASTLINUX_SCRIPTS

config BR2_PACKAGE_LUABITOP
	bool "luabitop"
	help
	  Lua BitOp is a C extension module for Lua 5.1
	  which adds bitwise operations on numbers.

	  https://bitop.luajit.org/

endif

endif #BR2_BUILD_USE_CUSTOM_SCRIPTS

if !BR2_BUILD_USE_CUSTOM_SCRIPTS

config BR2_PACKAGE_LUABITOP
	bool "luabitop"
	depends on BR2_PACKAGE_LUA_5_1
	help
	  Lua BitOp is a C extension module for Lua 5.1/5.2 which adds
	  bitwise operations on numbers.

	  http://bitop.luajit.org

comment "luabitop needs Lua 5.1"
	depends on !BR2_PACKAGE_LUA_5_1

endif #!BR2_BUILD_USE_CUSTOM_SCRIPTS
