if BR2_BUILD_USE_CUSTOM_SCRIPTS
if BR2_BUILD_USE_ASTLINUX_SCRIPTS

config BR2_PACKAGE_NETCALC
	bool "netcalc"
	help
	  netcalc is a slimmed down clone of sipcalc, using the output
	  format of ipcalc. It is written in C and has very few dependencies.
	  Both IPv4 and IPv6 is supported.

	  https://github.com/troglobit/netcalc


endif

endif #BR2_BUILD_USE_CUSTOM_SCRIPTS

if !BR2_BUILD_USE_CUSTOM_SCRIPTS

config BR2_PACKAGE_NETCALC
	bool "netcalc"
	help
	  netcalc (40 kiB) is a slimmed down version of sipcalc
	  using the popular output format of ipcalc.  Both IPv4
	  and IPv6 are supported.

	  https://github.com/troglobit/netcalc/

endif #!BR2_BUILD_USE_CUSTOM_SCRIPTS
